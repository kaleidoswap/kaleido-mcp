{
  "name": "kaleido-mcp",
  "version": "0.4.0",
  "description": "Unified MCP server for KaleidoSwap — WDK Spark wallet, Liquid wallet, RLN node, KaleidoSwap DEX, MPP/L402 payments, and 402index discovery in a single server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaleidoswap/kaleido-mcp"
  },
  "homepage": "https://github.com/kaleidoswap/kaleido-mcp#readme",
  "bugs": {
    "url": "https://github.com/kaleidoswap/kaleido-mcp/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mpp-client": {
      "import": "./dist/mpp-client.js",
      "types": "./dist/mpp-client.d.ts",
      "default": "./dist/mpp-client.js"
    }
  },
  "bin": "dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:contract": "node --test tests/*.test.mjs",
    "test": "npm run test:contract",
    "docs:tools": "npm run build && node scripts/gen-tools-doc.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tetherto/wdk-mcp-toolkit": "github:tetherto/wdk-mcp-toolkit#a77a546d16bdcdacfb29d88afe208d02af10bbf0",
    "kaleido-sdk": "^0.1.18",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@kaleidorg/wdk-wallet-liquid": "^1.0.0-beta.9",
    "@tetherto/wdk-wallet-spark": "^1.0.0-beta.28",
    "@kaleidorg/swap-sdk": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "@kaleidorg/wdk-wallet-liquid": {
      "optional": true
    },
    "@tetherto/wdk-wallet-spark": {
      "optional": true
    },
    "@kaleidorg/swap-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kaleidorg/swap-sdk": "^0.10.0",
    "@kaleidorg/wdk-wallet-liquid": "^1.0.0-beta.9",
    "@tetherto/wdk-wallet-spark": "^1.0.0-beta.28",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@tetherto/wdk-mcp-toolkit": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "zod": "$zod"
    },
    "axios": "^1.20.0",
    "@hono/node-server": "^1.19.15"
  }
}
